{
  "name": "gopherfy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:bot": "node src/bot/index.js",
    "start:otp": "node src/otp-service/index.js",
    "deploy:commands": "node src/bot/deploy.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPatterns integration",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src scripts --max-warnings 0",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write 'src/**/*.js' 'scripts/**/*.js' '*.{md,json}' '.github/**/*.{yml,yaml}' 'deploy/**/*.md'",
    "format:check": "prettier --check 'src/**/*.js' 'scripts/**/*.js' '*.{md,json}' '.github/**/*.{yml,yaml}' 'deploy/**/*.md'",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "prepare": "node -e \"if (process.env.CI === 'true' || process.env.CI === '1') process.exit(0)\" && husky",
    "verify": "npm ci && npm run lint && npm run format:check && npm test -- --ci && npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravindu-ranasinghe/umn-discord-verification.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/ravindu-ranasinghe/umn-discord-verification/issues"
  },
  "homepage": "https://github.com/ravindu-ranasinghe/umn-discord-verification#readme",
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@google-cloud/secret-manager": "^6.1.2",
    "@google-cloud/storage": "^7.19.0",
    "better-sqlite3": "^12.9.0",
    "discord-api-types": "^0.38.47",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-security": "^4.0.0",
    "fast-check": "^4.7.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  }
}
