DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
OTP_SERVICE_URL=http://localhost:3001
# Shared secret between the bot and the OTP service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SERVICE_KEY=
# Server-side HMAC key for OTP code storage (>=32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_KEY=
# Per-hour /send rate limits. Defaults: user=3, email=3, ip=30.
OTP_RATE_USER_PER_HOUR=3
OTP_RATE_EMAIL_PER_HOUR=3
OTP_RATE_IP_PER_HOUR=30
# Logger verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
