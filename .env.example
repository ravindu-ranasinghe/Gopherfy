# Discord application token + client id (https://discord.com/developers).
DISCORD_TOKEN=
CLIENT_ID=

# Optional: kept for convenience while bootstrapping a fresh guild.
# /setup writes these into the per-guild config table at runtime.
GUILD_ID=
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=

# OTP service location (the bot reaches this URL).
OTP_SERVICE_URL=http://localhost:3001
# Port the OTP service listens on (binds 127.0.0.1 only).
OTP_SERVICE_PORT=3001

# Shared secret between the bot and the OTP service. Used for
# HMAC-SHA256 request signing across the bot <-> OTP service hop.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SERVICE_KEY=

# Server-side HMAC key for OTP code storage and per-email rate-limit
# scope hashing. Must be >= 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_KEY=

# Per-hour /send rate limits. Defaults: user=3, email=3, ip=30.
OTP_RATE_USER_PER_HOUR=3
OTP_RATE_EMAIL_PER_HOUR=3
OTP_RATE_IP_PER_HOUR=30

# Resend API: production transactional email.
RESEND_API_KEY=
FROM_EMAIL=

# development | production. In production, DISCORD_TOKEN / OTP_* /
# RESEND_API_KEY are loaded from Secret Manager (not from these lines).
NODE_ENV=development

# Required when NODE_ENV=production — GCP project that owns the secrets.
GCP_PROJECT_ID=
# Logger verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
